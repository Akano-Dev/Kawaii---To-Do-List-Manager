{
  "rewrites": [
    { "source": "/dashboard", "destination": "/pages/dashboard.html" },
    { "source": "/login",     "destination": "/pages/login.html" },
    { "source": "/signup",    "destination": "/pages/signup.html" },
    { "source": "/settings",  "destination": "/pages/settings.html" },
    { "source": "/profile",   "destination": "/pages/profile.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
